# Copy to .env.local for local development; enter actual values securely, never in chat.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Exact application origin; https for a hosted environment.
APP_ORIGIN=http://localhost:3000
# Optional server-only service_role key for invitations/diagnostics and verified Tally intake.
# Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Optional inbound Tally enquiry webhook (server-only; configure securely in Vercel).
# TALLY_FORM_ID=mOLMrk
# TALLY_WEBHOOK_SIGNING_SECRET=
# Vercel integration compatibility: NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted
# instead of NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY. SUPABASE_URL is a URL fallback.

# Optional 013 secure uploads: configure an APPROVED real scanner before applying SQL.
# Server-only values, never NEXT_PUBLIC; see docs/SECURE-UPLOADS.md.
# UPLOAD_SCAN_URL=https://APPROVED_SCANNER_HOST/check
# UPLOAD_SCAN_KEY=
