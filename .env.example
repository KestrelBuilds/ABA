# Copy to .env.local for local development; enter actual values securely, never in chat.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Exact application origin; https for a hosted environment.
APP_ORIGIN=http://localhost:3000
# Optional: server-only legacy service_role key, required ONLY for owner-created invite links.
# Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
